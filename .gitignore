# ignore the .env file created if any.
.env

# Python Cache (Do not upload compiled bytecode)
__pycache__/
*.py[cod]
*$py.class

# Python Virtual Environments (If you test locally outside Docker)
venv/
env/
.venv/

# IDEs and Editors (Do not push your personal editor settings)
.vscode/
.idea/

# OS Generated Files (Prevents macOS/Windows clutter)
.DS_Store
Thumbs.db

# Terraform files and local state
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.lock.hcl